# Database
DATABASE_URL=postgresql+asyncpg://sps_user:sps_password_dev@postgres:5432/student_psychology
DATABASE_URL_SYNC=postgresql://sps_user:sps_password_dev@postgres:5432/student_psychology

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev
MINIO_BUCKET=student-reports
MINIO_SECURE=false

# App
APP_ENV=development
APP_DEBUG=true
APP_NAME=学生行为心理学分析系统
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
